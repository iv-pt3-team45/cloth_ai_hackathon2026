# ---- アプリ ----
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Google Cloud / Gemini ----
# 認証は ADC(Application Default Credentials)を使う。
# 事前に `gcloud auth application-default login` を実行しておくこと。
# このファイルに鍵や資格情報は書かない。
#
# Vertex AI (Google Cloud) 経由で Gemini を利用する場合は true
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# 新しい Gemini モデルは global でのみ提供される(us-central1 等だと 404 になる)
GOOGLE_CLOUD_LOCATION=global

# 【例外】Vertex AI を使わず AI Studio の API キーで動かす場合のみ設定。
# 通常は使わない(ADC が基本)。
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=

# ---- ADK (Agent Development Kit) ----
ADK_APP_NAME=tx-hackathon-gc
AGENT_NAME=chat_agent
AGENT_DESCRIPTION=ユーザーとの対話を担当するエージェント

# ---- モデル ----
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048
# エージェントの役割・口調(ADK の LlmAgent の instruction になる)
GEMINI_SYSTEM_INSTRUCTION=あなたは日本語で簡潔かつ正確に回答するアシスタントです。

# ---- YouTube Data API(MV のメタ情報取得) ----
# 【例外】YouTube Data API は ADC の既定スコープでは呼べないため API キーを使う。
# キーは GCP コンソールで作成し、「YouTube Data API v3」だけに制限すること。
# キーはこのファイル(.env.example)ではなく backend/.env にだけ書く。
YOUTUBE_DATA_API_KEY=
# MV 名で検索したときの候補数(検索は 1 回 100 ユニット消費する。既定の上限は 1 日 10,000)
YOUTUBE_SEARCH_MAX_RESULTS=5
# 検索結果の地域(空なら指定しない)
YOUTUBE_REGION_CODE=JP
# YouTube API の待ち時間の上限(秒)
YOUTUBE_REQUEST_TIMEOUT=10

# ---- アーティストのカルチャー情報(Gemini + Google 検索 + MV の映像解析) ----
# Google 検索(グラウンディング)と YouTube の動画入力に対応したモデルを指定する。
# 検索はモデル料金とは別に、実行された検索クエリの数だけ課金される(結果は保存しない)。
CULTURE_MODEL=gemini-3.5-flash-lite
# 調査・整理・映像の解析を合わせた待ち時間の上限(秒)
CULTURE_TIMEOUT=180

# ---- ライブ情報の検索(Gemini + Google 検索) ----
# Google 検索(グラウンディング)に対応したモデルを指定する。検索のたびにグラウンディングの料金がかかる。
LIVE_SEARCH_MODEL=gemini-3.5-flash-lite
# 調査・整理を合わせた待ち時間の上限(秒)
LIVE_SEARCH_TIMEOUT=120

# ---- メディア生成 ----
# 画像生成モデル(Nano Banana 2 Flash Lite)
IMAGE_MODEL=gemini-3.1-flash-lite-image
# 動画生成モデル(Gemini omni 1.1 Flash) ※Interactions API 経由で呼ぶ
VIDEO_MODEL=gemini-omni-1.1-flash-preview
# 生成物の保存先(backend/ からの相対パス)
CREATED_IMAGES_DIR=app/created_images
CREATED_VIDEOS_DIR=app/created_videos
MEDIA_GENERATION_TIMEOUT=300

# ---- エージェントループ ----
# 検証に使うモデル(生成モデルとクォータを分けたいときは別のモデルを指定する)
VERIFIER_MODEL=gemini-3.5-flash-lite
# 生成 → 検証 を繰り返す上限回数
LOOP_MAX_ITERATIONS=3

# ---- 服インデックス / 手持ちの服の登録 ----
# 服画像から属性(素材・形・色・系統・季節・暖かさ・使う場面)を抽出するモデル
CLOTH_INDEX_MODEL=gemini-3.5-flash-lite
# 登録した服のインデックス(backend/ からの相対パス)。チャットのエージェントもここを参照する。
# 写真は同じフォルダの images/ に保存される(Git 管理外)。
# サンプルを参照したい場合は tests/sample_cloth_indexs/index.json を指定する(登録もそこに書き込まれるので注意)
CLOTH_INDEX_PATH=data/wardrobe/index.json
# 登録する写真 1 枚の上限(バイト。既定 10 MB)
WARDROBE_MAX_IMAGE_BYTES=10485760
